NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hissab
DATABASE_SSL=false
DATABASE_POOL_MAX=10

JWT_ISSUER=hissab-api
JWT_AUDIENCE=hissab-mobile
JWT_ACCESS_SECRET=development-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600
TOKEN_HASH_SECRET=development-only-token-hash-secret-change-me
IDEMPOTENCY_HMAC_SECRET=development-only-idempotency-hmac-change-me
IDEMPOTENCY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
IDEMPOTENCY_TTL_SECONDS=86400

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_ENABLED=false
SWAGGER_ENABLED=true
